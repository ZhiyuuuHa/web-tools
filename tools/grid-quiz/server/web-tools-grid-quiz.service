[Unit]
Description=Web Tools Grid Quiz
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=web-tools-grid-quiz
StateDirectoryMode=0700
WorkingDirectory=/opt/web-tools-grid-quiz
ExecStart=/usr/bin/python3 /opt/web-tools-grid-quiz/tools/grid-quiz/server/app.py --host 0.0.0.0 --port 80 --data-dir /var/lib/web-tools-grid-quiz
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
